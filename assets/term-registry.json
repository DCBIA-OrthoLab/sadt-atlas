{
  "_doc": "Registre des termes. Cle = id du glossaire (g-<cle>). match = formes reconnues dans le texte (regex, casse respectee sauf mention nocase). atlas = cible optionnelle pour une page code, code = cible optionnelle depuis l'atlas, au format 'chemin/depuis/la/racine/de/la/langue.html#id'. Sans 'code', un terme de l'atlas renvoie au glossaire. terms.py applique le registre aux pages de 'scope'.",
  "scope": ["visor"],
  "terms": {
    "icp":         {"match": ["ICP"]},
    "lps":         {"match": ["LPS"]},
    "ras":         {"match": ["RAS"]},
    "landmark":    {"match": ["landmarks?"], "nocase": true},
    "heatmap":     {"match": ["heat ?maps?"], "nocase": true},
    "checkpoint":  {"match": ["checkpoints?"], "nocase": true},
    "nnunet":      {"match": ["nnU-Net"]},
    "unetr":       {"match": ["UNETR"]},
    "monai":       {"match": ["MONAI"]},
    "llamacpp":    {"match": ["llama\\.cpp"]},
    "gguf":        {"match": ["GGUF"]},
    "ollama":      {"match": ["Ollama"]},
    "cbct":        {"match": ["CBCT"]},
    "ios":         {"match": ["IOS"]},
    "voxel":       {"match": ["voxels?"], "nocase": true},
    "isosurface":  {"match": ["isosurfaces?"], "nocase": true},
    "marching-cubes": {"match": ["marching cubes"], "nocase": true},
    "svd":         {"match": ["SVD"]},
    "kabsch":      {"match": ["Kabsch"]},
    "procrustes":  {"match": ["Procrustes"]},
    "elastix":     {"match": ["elastix"], "nocase": true},
    "efficientnet": {"match": ["EfficientNet"]},
    "gradcam":     {"match": ["Grad-CAM"]},
    "lightgbm":    {"match": ["LightGBM"]},
    "fly-by":      {"match": ["fly-by"], "nocase": true},
    "presidio":    {"match": ["Presidio"]},
    "spacy":       {"match": ["spaCy"]},
    "bart":        {"match": ["BART"]},
    "tmj":         {"match": ["TMJ"]},
    "fov":         {"match": ["FOV"]},
    "condyle":     {"match": ["condyles?"], "nocase": true},
    "occlusal":    {"match": ["occlusal"], "nocase": true},
    "universal-id": {"match": ["Universal_ID"]}
  }
}
