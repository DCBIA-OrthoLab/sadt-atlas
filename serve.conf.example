# ─────────────────────────────────────────────────────────────
#  Qui peut voir le site. — MODÈLE
#
#  Copie ce fichier en « serve.conf » et adapte-le à ton
#  réseau : serve.conf est ignoré par git, les adresses de ta
#  machine ne partent donc jamais dans un commit.
#
#  Une entrée par ligne : une IP, un réseau CIDR, ou port = N.
#  Le « # » commente. Le fichier est relu à chaud : enregistre,
#  et la règle s'applique à la requête suivante — pas besoin de
#  redémarrer le serveur.
#
#  Le contenu du site, lui, est toujours lu sur disque : une page
#  régénérée par build.py est visible immédiatement.
# ─────────────────────────────────────────────────────────────

port = 8080

# La machine elle-même
127.0.0.1
::1

# Tout le tailnet Tailscale (plage CGNAT réservée à Tailscale)
100.64.0.0/10

# ── Ajoute ici les hôtes de ton réseau ──
# 198.51.100.17          # une machine
# 198.51.100.0/24        # tout un sous-réseau
